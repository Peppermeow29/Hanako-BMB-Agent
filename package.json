{
  "name": "hanako",
  "version": "0.450.0",
  "type": "module",
  "description": "HanaAgent - a personal AI agent with memory and soul",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "author": {
    "name": "liliMozi"
  },
  "keywords": [
    "ai-agent",
    "electron",
    "memory",
    "multi-platform",
    "personal-assistant"
  ],
  "main": "desktop/bootstrap.cjs",
  "bin": {
    "hana": "cli/entry.ts"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node scripts/ensure-windows-sandbox-helper.mjs && npm run build:preload && npm run build:renderer && npm run build:splash && npm run build:theme && node scripts/launch.js electron",
    "start:dev": "node scripts/ensure-windows-sandbox-helper.mjs && npm run build:preload && npm run build:renderer && npm run build:splash && npm run build:theme && node scripts/launch.js electron-dev",
    "start:vite": "node scripts/ensure-windows-sandbox-helper.mjs && npm run build:preload && node scripts/launch.js electron-vite",
    "dev:web": "node scripts/dev-web.js",
    "dev:renderer": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build:splash": "vite build --config vite.config.splash.ts",
    "build:theme": "vite build --config vite.config.theme.js",
    "build:preload": "vite build --config vite.config.preload.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "cli": "node scripts/launch.js cli",
    "server": "node scripts/launch.js server",
    "build:main": "vite build --config vite.config.main.js",
    "minicpm:setup": "node scripts/setup-minicpm5-mlx.mjs",
    "minicpm:server": "node scripts/minicpm5-mlx-server.mjs",
    "build:client": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:splash && npm run build:theme",
    "build:packages": "npm run build --workspaces --if-present",
    "test": "vitest run --exclude '**/.claude/**' --exclude '**/.cache/**' --exclude '**/dist/**' --exclude '**/dist-server/**' --exclude '**/dist-computer-use/**' --exclude '**/dist-sandbox/**'",
    "build:server": "node scripts/build-server.mjs",
    "build:server:open": "node scripts/build-server-open.mjs",
    "smoke:server:open": "node scripts/smoke-open-server.mjs",
    "export:open": "node scripts/export-open-tree.mjs",
    "rehearse:open": "node scripts/rehearse-open-export.mjs",
    "lint": "eslint .",
    "lint:boundary": "node scripts/lint-open-boundary.mjs",
    "test:watch": "vitest --exclude '**/.claude/**' --exclude '**/.cache/**' --exclude '**/dist/**' --exclude '**/dist-server/**' --exclude '**/dist-computer-use/**' --exclude '**/dist-sandbox/**'",
    "postinstall": "node scripts/patch-pi-sdk.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "6.43.0",
    "@earendil-works/pi-agent-core": "0.80.3",
    "@earendil-works/pi-ai": "0.80.3",
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@firecrawl/anydoc": "0.1.2",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@node-rs/jieba": "2.0.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tiptap/core": "^3.22.0",
    "@tiptap/extension-bold": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "diff": "8.0.4",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "hono": "^4.12.9",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.0.2",
    "katex": "^0.16.39",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.10.1",
    "motion": "12.40.0",
    "node-pty": "1.1.0",
    "proxy-agent": "6.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typebox": "1.1.38",
    "undici": "7.24.7",
    "unpdf": "1.6.2",
    "ws": "^8.18.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "form-data": "^4.0.0",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/nft": "^1.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "42.3.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pngjs": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
